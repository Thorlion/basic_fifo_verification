; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 0 11 1850 433 100 65

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / "" "/home/intern/CDC-VP/intern_dv/fifo/sim/wave.fsdb"

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
; waveform viewport range
zoom 78406.005404 180906.005404
cursor 111000.000000
marker 0.000000

; user define markers
; userMarker time_pos marker_name color linestyle
; visible top row signal index
top 0
; marker line index
markerPos 13

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


addGroup "G1"
activeDirFile "" "/home/intern/CDC-VP/intern_dv/fifo/sim/wave.fsdb"
addSignal -h 16 /tb_top_fifo/dut/Clk
addSignal -h 16 -UNSIGNED -HEX -holdScope Data_In[31:0]
addSignal -h 16 -holdScope FClrN
addSignal -h 16 -holdScope FInN
addSignal -h 16 -holdScope FOutN
addSignal -h 16 -UNSIGNED -HEX -holdScope F_Data[31:0]
addSignal -h 16 -holdScope F_EmptyN
addSignal -h 16 -holdScope F_FirstN
addSignal -h 16 -holdScope F_FullN
addSignal -h 16 -holdScope F_LastN
addSignal -h 16 -holdScope F_SLastN
addSignal -h 16 -holdScope ReadN
addSignal -h 16 /tb_top_fifo/Rst_N
addGroup "G2"

; getSignalForm Scope Hierarchy Status
; active file of getSignalForm
activeDirFile "" "/home/intern/CDC-VP/intern_dv/fifo/sim/wave.fsdb"

